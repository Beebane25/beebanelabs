  <!-- Mermaid.js: lazy-loaded only when diagrams exist on the page -->
  <script>
  document.addEventListener('DOMContentLoaded', function() {
    /* Only load Mermaid if there are .mermaid elements (250KB savings on non-article pages) */
    var mermaidEls = document.querySelectorAll('pre.mermaid');
    if (mermaidEls.length === 0) return;

    function getMermaidTheme() {
      var isNight = document.body.classList.contains('reading-sky-night');
      return {
        theme: isNight ? 'dark' : 'default',
        themeVariables: isNight ? {
          primaryColor: '#1a2332',
          primaryTextColor: '#E7E8F5',
          primaryBorderColor: '#39D9C4',
          lineColor: '#39D9C4',
          secondaryColor: '#0f1620',
          tertiaryColor: '#1a1f2e',
          edgeLabelBackground: '#0f1011',
          nodeTextColor: '#E7E8F5'
        } : {
          primaryColor: '#eaf4f0',
          primaryTextColor: '#10231F',
          primaryBorderColor: '#39D9C4',
          lineColor: '#39D9C4',
          secondaryColor: '#d4eae4',
          tertiaryColor: '#f0f7f4',
          edgeLabelBackground: '#ffffff',
          nodeTextColor: '#10231F'
        },
        fontFamily: "'Work Sans', system-ui, sans-serif",
        fontSize: 14,
        flowchart: { curve: 'basis', padding: 15 }
      };
    }

    var s = document.createElement('script');
    s.src = 'https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.min.js';
    s.onload = function() {
      if (typeof mermaid !== 'undefined') {
        mermaid.initialize(Object.assign({ startOnLoad: true }, getMermaidTheme()));
      }
    };
    document.head.appendChild(s);
  });
  </script>

<!-- Custom Cursor Script -->
<script>
(function(){
  if (window.matchMedia('(pointer: coarse)').matches) return;
  var dot = document.getElementById('cursorDot');
  if (!dot) return;

  var mouseX = 0, mouseY = 0;
  var isVisible = false;
  var lastSpawn = 0;
  var SPAWN_GAP = 60; // ms between particle spawns

  // Pollen color palette (from CSS vars)
  var pollenColors = ['#FBBF24','#F59E0B','#FCD34D','#FDE68A'];

  document.addEventListener('mousemove', function(e) {
    mouseX = e.clientX;
    mouseY = e.clientY;
    if (!isVisible) {
      dot.style.opacity = '1';
      isVisible = true;
    }
    dot.style.left = (mouseX - 12) + 'px';
    dot.style.top = (mouseY - 12) + 'px';

    // Spawn pollen particles
    var now = Date.now();
    if (now - lastSpawn > SPAWN_GAP) {
      lastSpawn = now;
      spawnPollen(e.clientX, e.clientY);
    }
  }, { passive: true });

  document.addEventListener('mouseleave', function() {
    dot.style.opacity = '0';
    isVisible = false;
  });

  document.addEventListener('mouseenter', function() {
    isVisible = true;
    dot.style.opacity = '1';
  });

  function spawnPollen(x, y) {
    var count = Math.random() < 0.3 ? 2 : 1; // sometimes spawn 2
    for (var i = 0; i < count; i++) {
      var p = document.createElement('div');
      p.className = 'pollen-particle';

      // Random size: 2px to 5px
      var size = 2 + Math.random() * 3;
      p.style.width = size + 'px';
      p.style.height = size + 'px';

      // Random position offset from cursor
      var ox = (Math.random() - 0.5) * 8;
      var oy = (Math.random() - 0.5) * 8;
      p.style.left = (x + ox) + 'px';
      p.style.top = (y + oy) + 'px';

      // Random color from palette
      p.style.background = pollenColors[Math.floor(Math.random() * pollenColors.length)];

      // Glow
      p.style.boxShadow = '0 0 ' + (2 + Math.random() * 4) + 'px ' + p.style.background;

      // Random drift direction and distance
      var angle = Math.random() * Math.PI * 2;
      var dist = 20 + Math.random() * 50;
      var dx = Math.cos(angle) * dist;
      var dy = Math.sin(angle) * dist - 15; // bias upward
      p.style.setProperty('--drift-x', dx + 'px');
      p.style.setProperty('--drift-y', dy + 'px');

      // Random duration: 0.5s to 1.2s
      var dur = 0.5 + Math.random() * 0.7;
      p.style.setProperty('--drift-duration', dur + 's');

      document.body.appendChild(p);

      // Cleanup after animation
      setTimeout(function() {
        if (p.parentNode) p.parentNode.removeChild(p);
      }, dur * 1000 + 50);
    }
  }
})();
</script>

