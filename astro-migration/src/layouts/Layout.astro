---
// src/layouts/Layout.astro — Replikasi persis dari index.html
import ReadingSky from '../components/ReadingSky.astro';
interface Props {
  title?: string;
  description?: string;
  keywords?: string;
  ogImage?: string;
  ogType?: string;
  canonicalUrl?: string;
  pageClass?: string;
}

const {
  title = 'BeebaneLabs - Portal Tutorial Teknologi & IT Indonesia',
  description = 'Tutorial lengkap teknologi & IT — Web Development, Database, AI & Data Science, Mobile, DevOps, Cloud, IoT, Cybersecurity, dan karir IT. Belajar dari nol hingga mahir.',
  keywords = 'tutorial IT, web development, HTML, CSS, JavaScript, React, Python, database, SQL, machine learning, AI, Flutter, Docker, AWS, DevOps, IoT, ESP32, cybersecurity, karir IT',
  ogImage = 'https://beebanelabs.pages.dev/images/logo_beebane.png',
  ogType = 'website',
  canonicalUrl = 'https://beebanelabs.pages.dev',
  pageClass = '',
} = Astro.props;
---

<!DOCTYPE html>
<html lang="id">

<head>

  <meta charset="UTF-8">

    <link rel="alternate" type="application/rss+xml" title="BeebaneLabs RSS" href="https://beebanelabs.pages.dev/rss.xml">
    <link rel="alternate" type="application/atom+xml" title="BeebaneLabs Atom" href="https://beebanelabs.pages.dev/atom.xml">
  <meta name="theme-color" content="#f0f7f4">
  <meta name="robots" content="index, follow">
  <meta name="google-site-verification" content="googlebb38388a1a1bdaed">
  <link rel="preconnect" href="https://*.supabase.co" crossorigin>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="preconnect" href="https://pagead2.googlesyndication.com">
  <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin>
  <link rel="dns-prefetch" href="https://ep1.adtrafficquality.google">
  <link rel="dns-prefetch" href="https://ep2.adtrafficquality.google">
  <link rel="dns-prefetch" href="https://unpkg.com">
  <link rel="preload" href="/css/style.css?v=16.0" as="style">
  <link rel="preload" href="/js/app.js?v=19.2" as="script">
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,500;0,9..144,600;1,9..144,500&family=Work+Sans:wght@400;500;600&family=JetBrains+Mono:wght@400&display=swap" rel="stylesheet">
  <script defer src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2/dist/umd/supabase.min.js"></script>
  <link rel="manifest" href="/manifest.json">
  <link rel="icon" type="image/x-icon" href="/favicon.ico">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <meta name="apple-mobile-web-app-title" content="BeebaneLabs">
  <link rel="apple-touch-icon" href="/images/logo_beebane.png">

  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover, minimum-scale=0.1, maximum-scale=3.0, user-scalable=yes">

  <title>{title}</title>

  <meta name="description" content={description}>

  <meta name="keywords" content={keywords}>

  <meta name="author" content="BeebaneLabs">

  <meta property="og:title" content={title}>

  <meta property="og:description" content={description}>

  <meta property="og:type" content={ogType}>

  <meta property="og:url" content={canonicalUrl}>

  <meta property="og:image" content={ogImage}>

  <meta name="twitter:card" content="summary_large_image">

  <meta name="twitter:title" content={title}>

  <meta name="twitter:description" content={description}>

  <meta name="twitter:image" content={ogImage}>

  <link rel="canonical" href={canonicalUrl}>

  <link rel="stylesheet" href="/css/style.css?v=16.0">
  <link rel="preload" href="/css/mobile-quick-menu.css" as="style" onload="this.onload=null;this.rel='stylesheet'">
  <noscript><link rel="stylesheet" href="/css/mobile-quick-menu.css"></noscript>

  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🐝</text></svg>">

  <script type="application/ld+json">

  {

    "@context": "https://schema.org",

    "@type": "WebSite",

    "name": "BeebaneLabs",

    "url": "https://beebanelabs.pages.dev",

    "description": "Portal tutorial teknologi & IT Indonesia. Web Development, Database, AI, Mobile, DevOps, Cybersecurity, dan banyak lagi.",

    "publisher": { "@type": "Organization", "name": "BeebaneLabs" }

  }

  </script>


  <script type="speculationrules">{ "prerender": [{ "where": { "href_matches": "/*" }, "eagerness": "moderate" }] }</script>
<script>
(function(){var src='https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-2122797411859663';function loadAds(){if(window._adsLoaded)return;window._adsLoaded=true;var s=document.createElement('script');s.async=true;s.crossOrigin='anonymous';s.src=src;document.head.appendChild(s);['scroll','mousedown','touchstart','keydown'].forEach(function(e){document.removeEventListener(e,loadAds,{passive:true})})}['scroll','mousedown','touchstart','keydown'].forEach(function(e){document.addEventListener(e,loadAds,{passive:true,once:true})});setTimeout(loadAds,5000)})();
</script>
</head>

<body class={pageClass}>
  <ReadingSky />
  <noscript><style>.article-content,.articles-grid,.category-section,.hero{display:block!important;opacity:1!important;transform:none!important}.reveal{opacity:1!important;transform:none!important}</style></noscript>

  <a href="#main-content" class="skip-link">Skip ke konten utama</a>



  <!-- ========== NAVIGATION ========== -->

  <nav class="navbar" id="navbar" role="navigation" aria-label="Navigasi utama">

    <div class="navbar-inner">

      <a href="/" class="navbar-brand">

        <picture><source srcset="/images/logo_beebane_webp.webp" type="image/webp"><img src="/images/logo_beebane_webp.webp" alt="BeebaneLabs" class="brand-logo" width="40" height="22" fetchpriority="high"></picture>

      </a>



      <ul class="navbar-links" id="navLinks">

        <li><a href="/">Beranda</a></li>

        <li><a href="/kategori.html">Kategori</a></li>

        <li><a href="/cheatsheet.html">Cheatsheet</a></li>

        <li><a href="/about.html">Tentang</a></li>

        <li><a href="/pricing.html">Harga</a></li>

      </ul>



      <div class="navbar-search" id="searchTrigger" role="button" tabindex="0" aria-label="Buka pencarian">

        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>

        <span>Cari tutorial...</span>

        <kbd>/</kbd>

      </div>


        <div class="navbar-right">

          <div id="authNavArea"></div>
          
        </div>

      <button class="menu-toggle" id="menuToggle" aria-label="Toggle menu">

        <span></span><span></span><span></span>

      </button>

      <button class="mobile-search-btn" id="mobileSearchBtn" aria-label="Cari">🔍</button>

    </div>

  </nav>



  <!-- ========== SEARCH OVERLAY ========== -->

  <div class="search-overlay" id="searchOverlay">
      <button class="search-close-btn" aria-label="Tutup pencarian">&times;</button>
      <div class="search-box">

        <div class="search-input-wrapper">

                  <input type="text" id="searchInput" placeholder="Ketik untuk mencari tutorial..." aria-label="Cari tutorial" autocomplete="off">

                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>

                </div>

        <div class="search-results" id="searchResults">

          <div class="search-hint">Ketik untuk mencari</div>

        </div>

      </div>

  </div>


  <!-- ========== SLOT (KONTEN HALAMAN) ========== -->
  <main id="main-content">
    <slot />
  </main>


  <!-- ========== FOOTER ========== -->

      <footer class="footer" role="contentinfo">

    <div class="container">

      <div class="footer-grid">

        <div class="footer-brand">

          <img src="/images/logo_beebane_webp.webp" alt="BeebaneLabs" class="footer-logo" loading="lazy" width="40" height="22">

          <p>Portal tutorial teknologi & IT Indonesia. Web Development, Database, AI, Mobile, DevOps, Cybersecurity, dan banyak lagi — belajar gratis, konten original.</p>

        </div>

        <div class="footer-col">

          <h4>Kategori</h4>

          <ul>

            <li><a href="/kategori/iot.html">Internet of Things</a></li>

            <li><a href="/kategori/web-development.html">Web Development</a></li>

            <li><a href="/kategori/database.html">Database</a></li>

            <li><a href="/kategori/ai-data-science.html">AI & Data Science</a></li>

            <li><a href="/kategori/mobile.html">Mobile Development</a></li>

            <li><a href="/kategori/devops-cloud.html">DevOps & Cloud</a></li>

            <li><a href="/kategori/keamanan.html">Cybersecurity</a></li>

            <li><a href="/kategori/it-career.html">IT Career</a></li>

          </ul>

        </div>

        <div class="footer-col">

          <h4>Populer</h4>

          <ul>

            <li><a href="/articles/esp32-fundamentals.html">Tutorial ESP32</a></li>

            <li><a href="/articles/html-css-dasar.html">HTML & CSS Dasar</a></li>

            <li><a href="/articles/javascript-dasar.html">JavaScript Dasar</a></li>

            <li><a href="/articles/python-data-science.html">Python Data Science</a></li>

            <li><a href="/articles/docker-dasar.html">Docker untuk Developer</a></li>

          </ul>

        </div>

        <div class="footer-col">

          <h4>Lainnya</h4>

          <ul>

            <li><a href="/about.html">Tentang Kami</a></li>

            <li><a href="/privacy-policy.html">Kebijakan Privasi</a></li>

            <li><a href="/contact.html">Kontak</a></li>

            <li><a href="/rss.xml" target="_blank">RSS Feed</a></li>

          </ul>

        </div>

      </div>

      <div class="footer-bottom">

        <div class="footer-social">

          <a href="https://github.com/Beebane25" target="_blank" rel="noopener">GitHub</a>

        </div>

        <p>&copy; 2026 BeebaneLabs. Semua hak dilindungi.</p>

      </div>

    </div>

  </footer>


  <!-- ========== BACK TO TOP ========== -->

  <button class="back-to-top" id="backToTop" aria-label="Kembali ke atas">↑</button>


  <!-- ========== SCRIPTS ========== -->

  <script defer src="/js/security.js?v=1.0"></script>
  <script defer src="/js/app.js?v=19.2"></script>
  <script defer src="/js/mobile-zoom.js?v=9.2"></script>
  <script defer src="/js/diagram-interactions.js?v=1.0"></script>
  <!-- Mermaid.js: lazy-loaded only when diagrams exist on the page -->
  <script>
  document.addEventListener('DOMContentLoaded', function() {
    /* Only load Mermaid if there are .mermaid elements (250KB savings on non-article pages) */
    var mermaidEls = document.querySelectorAll('pre.mermaid');
    if (mermaidEls.length === 0) return;

    function getMermaidTheme() {
      var isNight = document.body.classList.contains('reading-sky-night');
      return {
        theme: isNight ? 'dark' : 'default',
        themeVariables: isNight ? {
          primaryColor: '#1a2332',
          primaryTextColor: '#E7E8F5',
          primaryBorderColor: '#39D9C4',
          lineColor: '#39D9C4',
          secondaryColor: '#0f1620',
          tertiaryColor: '#1a1f2e',
          edgeLabelBackground: '#0f1011',
          nodeTextColor: '#E7E8F5'
        } : {
          primaryColor: '#eaf4f0',
          primaryTextColor: '#10231F',
          primaryBorderColor: '#39D9C4',
          lineColor: '#39D9C4',
          secondaryColor: '#d4eae4',
          tertiaryColor: '#f0f7f4',
          edgeLabelBackground: '#ffffff',
          nodeTextColor: '#10231F'
        },
        fontFamily: "'Work Sans', system-ui, sans-serif",
        fontSize: 14,
        flowchart: { curve: 'basis', padding: 15 }
      };
    }

    var s = document.createElement('script');
    s.src = 'https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.min.js';
    s.onload = function() {
      if (typeof mermaid !== 'undefined') {
        mermaid.initialize(Object.assign({ startOnLoad: true }, getMermaidTheme()));
      }
    };
    document.head.appendChild(s);
  });
  </script>

<button class="theme-toggle-floating" title="Ganti tema" aria-label="Ganti tema">☀️</button>

<!-- MOBILE QUICK MENU -->
  <div id="quickMenuBackdrop" class="quick-menu-backdrop"></div>
  <button id="quickMenuBtn" class="quick-menu-btn" title="Menu" aria-label="Menu cepat">⚙️</button>
  <div id="quickMenuPanel" class="quick-menu-panel">
    <div class="quick-menu-section">
      <span class="quick-menu-label">🔍 Zoom</span>
      <div class="quick-menu-row">
        <button aria-label="Perkecil">−</button>
        <span id="quickMenuZoomLevel" class="zoom-level">100%</span>
        <button aria-label="Perbesar">+</button>
        <button class="btn-zoom-reset" aria-label="Reset zoom">↺</button>
      </div>
    </div>
    <div class="quick-menu-section">
      <span class="quick-menu-label">🎨 Tema</span>
      <button class="quick-menu-row quick-menu-theme-btn" aria-label="Ganti tema">
        <span id="quickMenuThemeIcon">☀️</span> <span>Ganti Tema</span>
      </button>
    </div>
  </div>


</body>

</html>
