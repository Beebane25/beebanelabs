---
/**
 * ReadingSky.astro
 * Day mode: CSS gradient + sun + clouds + light rays
 * Night mode: Three.js canvas (stars, moon, mountains, fireflies)
 */

interface Props {
  initialMode?: 'day' | 'night';
}

const { initialMode = 'day' } = Astro.props;
---

<!-- Day mode background elements -->
<div id="reading-sky-day" aria-hidden="true">
  <div class="rs-rays"></div>
  <div class="rs-sun-wrap">
    <div class="rs-sun-glow"></div>
    <div class="rs-sun-core"></div>
  </div>
  <div class="rs-cloud-layer">
    <div class="rs-cloud rs-cloud1"></div>
    <div class="rs-cloud rs-cloud2"></div>
    <div class="rs-cloud rs-cloud3"></div>
    <div class="rs-cloud rs-cloud4"></div>
  </div>
</div>

<!-- Night mode: Three.js canvas -->
<canvas id="reading-sky-canvas"></canvas>

<button id="reading-sky-toggle" aria-label="Ganti mode siang/malam">
  <span class="knob"></span>
</button>

<div id="reading-sky-hud">
  <span class="dot"></span>
  <span class="clock">☀️</span>
  <span class="phase">Siang</span>
</div>

<style>
  /* ========== DAY MODE BACKGROUND ========== */
  #reading-sky-day {
    position: fixed;
    inset: 0;
    z-index: -3;
    background: linear-gradient(180deg, #bfe3fb 0%, #e8f4fd 45%, #fdf6e8 100%);
    transition: opacity 1.2s ease;
  }

  body.reading-sky-night #reading-sky-day {
    opacity: 0;
    pointer-events: none;
  }

  /* Light rays */
  .rs-rays {
    position: fixed; inset: 0; z-index: 0; pointer-events: none;
    background: conic-gradient(from 200deg at 78% 12%,
      rgba(255,244,214,0.35) 0deg, transparent 25deg,
      rgba(255,244,214,0.25) 45deg, transparent 70deg,
      rgba(255,244,214,0.3) 95deg, transparent 130deg);
    animation: rs-rayDrift 40s linear infinite;
    opacity: 0.7;
  }

  @keyframes rs-rayDrift {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
  }

  /* Sun */
  .rs-sun-wrap {
    position: fixed; top: 6%; right: 10%; z-index: 1; pointer-events: none;
  }
  .rs-sun-glow {
    width: 220px; height: 220px; border-radius: 50%;
    background: radial-gradient(circle, rgba(255,230,160,0.8) 0%, rgba(255,230,160,0.25) 45%, transparent 70%);
    position: absolute; top: -70px; left: -70px;
    animation: rs-breathe 6s ease-in-out infinite;
  }
  .rs-sun-core {
    width: 80px; height: 80px; border-radius: 50%;
    background: radial-gradient(circle at 35% 30%, #fffdf5, #fff6d8 55%, #ffe9ad 100%);
    box-shadow: 0 0 40px 10px rgba(255,230,160,0.5);
    animation: rs-breathe 6s ease-in-out infinite;
  }
  @keyframes rs-breathe {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.06); }
  }

  /* Clouds */
  .rs-cloud-layer {
    position: fixed; inset: 0; z-index: 1; pointer-events: none; overflow: hidden;
  }
  .rs-cloud {
    position: absolute;
    background: #fff;
    border-radius: 100px;
    opacity: 0.85;
    filter: drop-shadow(0 8px 12px rgba(150,170,190,0.25));
  }
  .rs-cloud::before, .rs-cloud::after {
    content: "";
    position: absolute;
    background: #fff;
    border-radius: 100px;
  }

  .rs-cloud1 {
    width: 140px; height: 44px; top: 14%; left: -200px;
    animation: rs-drift1 55s linear infinite;
  }
  .rs-cloud1::before { width: 70px; height: 70px; top: -34px; left: 20px; }
  .rs-cloud1::after { width: 50px; height: 50px; top: -24px; left: 80px; }

  .rs-cloud2 {
    width: 100px; height: 32px; top: 26%; left: -180px;
    animation: rs-drift2 70s linear infinite; opacity: 0.7;
  }
  .rs-cloud2::before { width: 50px; height: 50px; top: -24px; left: 14px; }
  .rs-cloud2::after { width: 36px; height: 36px; top: -16px; left: 56px; }

  .rs-cloud3 {
    width: 180px; height: 54px; top: 8%; left: -260px;
    animation: rs-drift3 90s linear infinite; opacity: 0.6;
  }
  .rs-cloud3::before { width: 90px; height: 90px; top: -44px; left: 26px; }
  .rs-cloud3::after { width: 60px; height: 60px; top: -28px; left: 110px; }

  .rs-cloud4 {
    width: 120px; height: 38px; top: 38%; left: -200px;
    animation: rs-drift1 65s linear infinite; animation-delay: -20s; opacity: 0.55;
  }
  .rs-cloud4::before { width: 60px; height: 60px; top: -28px; left: 18px; }
  .rs-cloud4::after { width: 40px; height: 40px; top: -18px; left: 68px; }

  @keyframes rs-drift1 {
    from { transform: translateX(0); }
    to { transform: translateX(160vw); }
  }
  @keyframes rs-drift2 {
    from { transform: translateX(0); }
    to { transform: translateX(160vw); }
  }
  @keyframes rs-drift3 {
    from { transform: translateX(0); }
    to { transform: translateX(160vw); }
  }

  /* ========== NIGHT MODE CANVAS ========== */
  #reading-sky-canvas {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100vh;
    z-index: -2;
    display: block;
    opacity: 0;
    transition: opacity 1.2s ease;
  }

  body.reading-sky-night #reading-sky-canvas {
    opacity: 1;
  }

  /* ========== TOGGLE & HUD ========== */
  #reading-sky-hud {
    position: fixed;
    left: 20px;
    bottom: 20px;
    z-index: 50;
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 16px 10px 12px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.7);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border: 1px solid rgba(255,255,255,0.4);
    box-shadow: 0 10px 30px rgba(0,0,0,0.1);
    transition: background 1.2s ease, border-color 1.2s ease, box-shadow 1.2s ease;
    color: #2b3a4a;
  }
  #reading-sky-hud .dot {
    width: 8px; height: 8px; border-radius: 50%;
    background: #39D9C4;
    box-shadow: 0 0 8px #39D9C4;
    flex-shrink: 0;
  }
  #reading-sky-hud .clock { font-size: 14px; font-weight: 500; min-width: 30px; }
  #reading-sky-hud .phase { font-size: 12px; opacity: 0.75; }

  #reading-sky-toggle {
    position: fixed;
    top: 20px;
    right: 20px;
    z-index: 50;
    width: 56px;
    height: 30px;
    border-radius: 999px;
    border: 1px solid rgba(255,255,255,0.4);
    background: rgba(255, 255, 255, 0.7);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    cursor: pointer;
    padding: 3px;
    transition: background 1.2s ease, border-color 1.2s ease;
  }
  #reading-sky-toggle .knob {
    width: 22px; height: 22px; border-radius: 50%;
    background: #39D9C4;
    transition: transform 0.5s cubic-bezier(.65,0,.35,1), background 0.5s ease;
    box-shadow: 0 2px 8px rgba(0,0,0,0.15);
  }

  /* Night mode overrides for HUD & Toggle */
  :global(body.reading-sky-night) #reading-sky-hud {
    background: rgba(14, 18, 36, 0.72);
    border-color: rgba(255,255,255,0.08);
    color: #E7E8F5;
    box-shadow: 0 10px 30px rgba(0,0,0,0.3);
  }
  :global(body.reading-sky-night) #reading-sky-toggle {
    background: rgba(14, 18, 36, 0.72);
    border-color: rgba(255,255,255,0.08);
  }
  :global(body.reading-sky-night) #reading-sky-toggle .knob {
    transform: translateX(26px);
    background: #DCE3F0;
  }

  /* Reduce motion */
  @media (prefers-reduced-motion: reduce) {
    .rs-sun-glow, .rs-sun-core, .rs-cloud, .rs-rays { animation: none !important; }
  }
</style>

<script is:inline>
document.addEventListener('DOMContentLoaded', function() {
  var THREE = window.THREE;

  /* ====== STATE ====== */
  var THEME_KEY = 'beebanelabs_theme';
  var isNightMode = false;

  /* Restore saved theme */
  var saved = localStorage.getItem(THEME_KEY);
  if (saved === 'night') {
    isNightMode = true;
    document.body.classList.add('reading-sky-night');
  }

  var toggleBtn = document.getElementById('reading-sky-toggle');
  var clockEl = document.querySelector('#reading-sky-hud .clock');
  var phaseEl = document.querySelector('#reading-sky-hud .phase');

  function updateHud() {
    clockEl.textContent = isNightMode ? '🌙' : '☀️';
    phaseEl.textContent = isNightMode ? 'Malam' : 'Siang';
  }

  toggleBtn.addEventListener('click', function() {
    isNightMode = !isNightMode;
    document.body.classList.toggle('reading-sky-night', isNightMode);
    localStorage.setItem(THEME_KEY, isNightMode ? 'night' : 'day');
    var meta = document.querySelector('meta[name="theme-color"]');
    if (meta) meta.content = isNightMode ? '#08090a' : '#bfe3fb';
    updateHud();
  });

  updateHud();

  /* ====== THREE.JS NIGHT MODE ====== */
  if (!THREE) {
    console.error('THREE.js not loaded — night mode disabled');
    return;
  }

  var PAL = {
    day: {
      skyTop: new THREE.Color('#bfe3fb'),
      skyHorizon: new THREE.Color('#fdf6e8'),
      ground: new THREE.Color('#1F3A3D'),
      groundFar: new THREE.Color('#2C4F4F')
    },
    night: {
      skyTop: new THREE.Color('#050714'),
      skyHorizon: new THREE.Color('#2B2B52'),
      ground: new THREE.Color('#05070A'),
      groundFar: new THREE.Color('#0a0c17')
    }
  };

  var canvas = document.getElementById('reading-sky-canvas');
  if (!canvas) return;

  var renderer = new THREE.WebGLRenderer({ canvas: canvas, antialias: true });
  renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
  renderer.setSize(window.innerWidth, window.innerHeight);

  var scene = new THREE.Scene();
  var camera = new THREE.PerspectiveCamera(55, window.innerWidth / window.innerHeight, 0.1, 2000);
  camera.position.set(0, 12, 46);
  camera.lookAt(0, 14, -60);

  /* Sky dome */
  var skyGeo = new THREE.SphereGeometry(400, 32, 32);
  var skyMat = new THREE.ShaderMaterial({
    uniforms: { uTop: { value: new THREE.Color() }, uHorizon: { value: new THREE.Color() } },
    side: THREE.BackSide,
    depthWrite: false,
    vertexShader: 'varying vec3 vPos; void main(){ vPos = position; gl_Position = projectionMatrix * modelViewMatrix * vec4(position, 1.0); }',
    fragmentShader: 'uniform vec3 uTop; uniform vec3 uHorizon; varying vec3 vPos; void main(){ float h = clamp(normalize(vPos).y * 1.4 + 0.15, 0.0, 1.0); gl_FragColor = vec4(mix(uHorizon, uTop, h), 1.0); }'
  });
  scene.add(new THREE.Mesh(skyGeo, skyMat));

  /* Stars */
  var STAR_COUNT = 900;
  var starGeo = new THREE.BufferGeometry();
  var starPos = new Float32Array(STAR_COUNT * 3);
  for (var i = 0; i < STAR_COUNT; i++) {
    var r = 300 + Math.random() * 60;
    var theta = Math.random() * Math.PI * 2;
    var phi = Math.acos(Math.random() * 0.85);
    starPos[i*3] = r * Math.sin(phi) * Math.cos(theta);
    starPos[i*3+1] = Math.abs(r * Math.cos(phi)) + 20;
    starPos[i*3+2] = r * Math.sin(phi) * Math.sin(theta) - 100;
  }
  starGeo.setAttribute('position', new THREE.BufferAttribute(starPos, 3));
  var starMat = new THREE.PointsMaterial({ color: 0xffffff, size: 1.6, transparent: true, opacity: 0, depthWrite: false });
  scene.add(new THREE.Points(starGeo, starMat));

  /* Glow texture */
  function makeGlowTexture(hex) {
    var size = 128;
    var c = document.createElement('canvas');
    c.width = c.height = size;
    var ctx = c.getContext('2d');
    var g = ctx.createRadialGradient(size/2,size/2,0,size/2,size/2,size/2);
    g.addColorStop(0, hex + 'ff');
    g.addColorStop(0.35, hex + '88');
    g.addColorStop(1, hex + '00');
    ctx.fillStyle = g;
    ctx.fillRect(0,0,size,size);
    return new THREE.CanvasTexture(c);
  }

  /* Moon */
  var moon = new THREE.Mesh(new THREE.SphereGeometry(5, 24, 24), new THREE.MeshBasicMaterial({ color: 0xDCE3F0 }));
  var moonGlow = new THREE.Sprite(new THREE.SpriteMaterial({ map: makeGlowTexture('#8FA8D6'), transparent: true, depthWrite: false, blending: THREE.AdditiveBlending }));
  moonGlow.scale.set(34, 34, 1);
  moon.add(moonGlow);
  scene.add(moon);

  /* Mountains */
  function makeMountainRow(zPos, height, color) {
    var points = [];
    var segs = 10;
    for (var j = 0; j <= segs; j++) {
      var x = (j/segs - 0.5) * 500;
      var y = Math.sin(j*1.7 + zPos) * height * 0.4 + height * (0.4 + Math.random()*0.3);
      points.push(new THREE.Vector2(x, y));
    }
    points.unshift(new THREE.Vector2(-250, -20));
    points.push(new THREE.Vector2(250, -20));
    var shape = new THREE.Shape(points);
    var mesh = new THREE.Mesh(new THREE.ShapeGeometry(shape), new THREE.MeshBasicMaterial({ color: color }));
    mesh.position.z = zPos;
    mesh.position.y = -6;
    return mesh;
  }
  var groundFar = makeMountainRow(-90, 22, PAL.night.groundFar.getHex());
  var groundNear = makeMountainRow(-40, 14, PAL.night.ground.getHex());
  scene.add(groundFar, groundNear);

  /* Trees */
  var treeGroup = new THREE.Group();
  var treeGeo = new THREE.ConeGeometry(1.6, 5, 6);
  for (var ti = 0; ti < 22; ti++) {
    var t = new THREE.Mesh(treeGeo, new THREE.MeshBasicMaterial({ color: PAL.night.ground.getHex() }));
    t.position.set((Math.random()-0.5)*140, -3 + Math.random()*1.5, -30 - Math.random()*15);
    t.scale.setScalar(0.7 + Math.random()*0.9);
    treeGroup.add(t);
  }
  scene.add(treeGroup);

  /* Fireflies */
  var FIREFLY_COUNT = 40;
  var fireflyGeo = new THREE.BufferGeometry();
  var fPos = new Float32Array(FIREFLY_COUNT*3);
  var fSeed = new Float32Array(FIREFLY_COUNT);
  for (var fi = 0; fi < FIREFLY_COUNT; fi++) {
    fPos[fi*3] = (Math.random()-0.5)*100;
    fPos[fi*3+1] = -2 + Math.random()*8;
    fPos[fi*3+2] = -35 + Math.random()*30;
    fSeed[fi] = Math.random()*Math.PI*2;
  }
  fireflyGeo.setAttribute('position', new THREE.BufferAttribute(fPos, 3));
  var fireflyMat = new THREE.PointsMaterial({ color: 0xC9F26C, size: 2.2, transparent: true, opacity: 0, depthWrite: false, blending: THREE.AdditiveBlending });
  scene.add(new THREE.Points(fireflyGeo, fireflyMat));

  /* State */
  var timeOfDay = 0.75; // Start night (canvas hidden by CSS)
  var manualTarget = null;
  var mouseX = 0, mouseY = 0;
  var clock = new THREE.Clock();

  window.addEventListener('mousemove', function(e) {
    mouseX = (e.clientX / window.innerWidth - 0.5);
    mouseY = (e.clientY / window.innerHeight - 0.5);
  });

  /* Animate time when toggling */
  var origToggle = toggleBtn.onclick;
  toggleBtn.addEventListener('click', function() {
    manualTarget = isNightMode ? 0.75 : 0.25;
  });

  window.addEventListener('resize', function() {
    camera.aspect = window.innerWidth / window.innerHeight;
    camera.updateProjectionMatrix();
    renderer.setSize(window.innerWidth, window.innerHeight);
  });

  function animate() {
    requestAnimationFrame(animate);
    var dt = clock.getDelta();
    var t = clock.getElapsedTime();

    if (manualTarget !== null) {
      timeOfDay += (manualTarget - timeOfDay) * Math.min(1, dt * 2.2);
      if (Math.abs(manualTarget - timeOfDay) < 0.002) {
        timeOfDay = manualTarget;
        manualTarget = null;
      }
    }

    var angle = timeOfDay * Math.PI * 2;
    var sunHeight = Math.sin(angle);
    var moonHeight = Math.sin(angle + Math.PI);
    var nightFactor = Math.max(0, moonHeight);

    /* Moon position */
    moon.position.set(Math.cos(angle + Math.PI) * -130, 20 + moonHeight * 70, -140);
    moon.visible = moonHeight > -0.08;

    /* Sky colors (always dark for night canvas) */
    skyMat.uniforms.uTop.value.copy(PAL.night.skyTop);
    skyMat.uniforms.uHorizon.value.copy(PAL.night.skyHorizon);

    /* Ground */
    groundNear.material.color.copy(PAL.night.ground);
    groundFar.material.color.copy(PAL.night.groundFar);
    treeGroup.children.forEach(function(tr) { tr.material.color.copy(PAL.night.ground); });

    /* Stars & fireflies */
    starMat.opacity = nightFactor * 0.9;
    fireflyMat.opacity = nightFactor * 0.85;
    var fAttr = fireflyGeo.attributes.position;
    for (var i = 0; i < FIREFLY_COUNT; i++) {
      fAttr.array[i*3] += Math.sin(t*0.6 + fSeed[i]) * 0.02;
      fAttr.array[i*3+1] += Math.cos(t*0.8 + fSeed[i]) * 0.015;
    }
    fAttr.needsUpdate = true;

    /* Camera parallax */
    camera.position.x += (mouseX * 8 - camera.position.x) * 0.03;
    camera.position.y += (12 - mouseY * 4 - camera.position.y) * 0.03;
    camera.lookAt(0, 14, -60);

    renderer.render(scene, camera);
  }

  animate();
});
</script>
