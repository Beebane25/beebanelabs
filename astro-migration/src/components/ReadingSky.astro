---
/**
 * ReadingSky.astro
 * Day mode: CSS gradient + sun + clouds + light rays
 * Night mode: Three.js canvas (stars, moon, mountains, fireflies)
 *
 * PERFORMANCE: Three.js is lazy-loaded — only fetched when user
 * switches to night mode (or returns in night mode). Saves ~556KB
 * on initial page load for day-mode users.
 */

interface Props {
  initialMode?: 'day' | 'night';
}

const { initialMode = 'day' } = Astro.props;
---

<!-- Day mode background elements -->
<div id="reading-sky-day" aria-hidden="true">
  <div class="rs-rays"></div>
  <div class="rs-sun-wrap">
    <div class="rs-sun-glow"></div>
    <div class="rs-sun-core"></div>
  </div>
  <div class="rs-cloud-layer">
    <div class="rs-cloud rs-cloud1"></div>
    <div class="rs-cloud rs-cloud2"></div>
    <div class="rs-cloud rs-cloud3"></div>
    <div class="rs-cloud rs-cloud4"></div>
  </div>
</div>

<!-- Night mode: Three.js canvas -->
<canvas id="reading-sky-canvas"></canvas>

<button id="reading-sky-toggle" aria-label="Ganti mode siang/malam">
  <span class="knob"></span>
</button>

<div id="reading-sky-hud">
  <span class="dot"></span>
  <span class="clock">☀️</span>
  <span class="phase">Siang</span>
</div>

<style>
  /* ========== DAY MODE BACKGROUND ========== */
  #reading-sky-day {
    position: fixed;
    inset: 0;
    z-index: -3;
    background: linear-gradient(180deg, #bfe3fb 0%, #e8f4fd 45%, #fdf6e8 100%);
    transition: opacity 1.2s ease;
    opacity: 1;
  }
  body.reading-sky-night #reading-sky-day { opacity: 0; pointer-events: none; }

  /* Sun */
  .rs-sun-wrap {
    position: absolute;
    top: 12%;
    right: 18%;
    width: 90px;
    height: 90px;
  }
  .rs-sun-core {
    position: absolute;
    inset: 15px;
    border-radius: 50%;
    background: radial-gradient(circle, #fff7d4 0%, #ffd54f 60%, #ffb300 100%);
    box-shadow: 0 0 60px 20px rgba(255,200,0,0.3);
    animation: sunPulse 4s ease-in-out infinite;
  }
  .rs-sun-glow {
    position: absolute;
    inset: -30px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(255,220,80,0.35) 0%, transparent 70%);
    animation: sunGlow 6s ease-in-out infinite;
  }

  /* Clouds */
  .rs-cloud-layer {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }
  .rs-cloud {
    position: absolute;
    width: 200px;
    height: 60px;
    background: rgba(255,255,255,0.7);
    border-radius: 60px;
    filter: blur(2px);
    animation: cloudDrift linear infinite;
  }
  .rs-cloud::before, .rs-cloud::after {
    content: '';
    position: absolute;
    background: inherit;
    border-radius: 50%;
  }
  .rs-cloud::before { width: 80px; height: 80px; top: -35px; left: 30px; }
  .rs-cloud::after { width: 60px; height: 60px; top: -20px; right: 30px; }
  .rs-cloud1 { top: 15%; animation-duration: 45s; opacity: 0.8; }
  .rs-cloud2 { top: 28%; animation-duration: 60s; animation-delay: -15s; opacity: 0.6; transform: scale(0.7); }
  .rs-cloud3 { top: 40%; animation-duration: 55s; animation-delay: -30s; opacity: 0.5; transform: scale(0.5); }
  .rs-cloud4 { top: 22%; animation-duration: 70s; animation-delay: -45s; opacity: 0.4; transform: scale(0.9); }

  /* Rays */
  .rs-rays {
    position: absolute;
    top: 8%;
    right: 14%;
    width: 200px;
    height: 200px;
    background: conic-gradient(from 0deg, transparent 0%, rgba(255,220,80,0.08) 5%, transparent 10%, transparent 15%, rgba(255,220,80,0.06) 20%, transparent 25%, transparent 30%, rgba(255,220,80,0.08) 35%, transparent 40%, transparent 45%, rgba(255,220,80,0.05) 50%, transparent 55%, transparent 60%, rgba(255,220,80,0.07) 65%, transparent 70%, transparent 75%, rgba(255,220,80,0.06) 80%, transparent 85%, transparent 90%, rgba(255,220,80,0.08) 95%, transparent 100%);
    animation: raysSpin 30s linear infinite;
    opacity: 0.8;
  }
  body.reading-sky-night .rs-rays { opacity: 0; }

  /* Canvas (night) */
  #reading-sky-canvas {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100vh;
    z-index: -3;
    opacity: 0;
    transition: opacity 1.2s ease;
    pointer-events: none;
  }
  body.reading-sky-night #reading-sky-canvas { opacity: 1; }

  /* Toggle */
  #reading-sky-toggle {
    position: fixed;
    bottom: 80px;
    right: 18px;
    width: 54px;
    height: 28px;
    border-radius: 14px;
    border: 2px solid var(--panel-border, rgba(255,255,255,0.2));
    background: var(--panel, rgba(255,255,255,0.15));
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    cursor: pointer;
    z-index: 10000;
    padding: 0;
    transition: background 0.3s, border-color 0.3s;
  }
  #reading-sky-toggle:hover { border-color: var(--accent, #39D9C4); }
  #reading-sky-toggle .knob {
    display: block;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: #ffd54f;
    box-shadow: 0 0 8px rgba(255,200,0,0.5);
    transition: transform 0.35s cubic-bezier(.4,0,.2,1), background 0.35s, box-shadow 0.35s;
    transform: translateX(2px);
  }
  body.reading-sky-night #reading-sky-toggle .knob {
    transform: translateX(28px);
    background: #8fa8d6;
    box-shadow: 0 0 10px rgba(143,168,214,0.6);
  }

  /* HUD */
  #reading-sky-hud {
    position: fixed;
    bottom: 114px;
    right: 14px;
    display: flex;
    align-items: center;
    gap: 6px;
    background: var(--panel, rgba(255,255,255,0.12));
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border: 1px solid var(--panel-border, rgba(255,255,255,0.1));
    border-radius: 10px;
    padding: 4px 10px;
    font-size: 0.72rem;
    color: var(--text, #10231F);
    z-index: 10000;
    pointer-events: none;
  }
  #reading-sky-hud .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #4ade80;
    animation: hudPulse 2s ease-in-out infinite;
  }

  /* Reduced motion */
  @media (prefers-reduced-motion: reduce) {
    .rs-sun-core, .rs-sun-glow, .rs-rays, .rs-cloud { animation: none !important; }
  }

  /* NOTE: @keyframes (cloudDrift, sunPulse, sunGlow, raysSpin, hudPulse)
     are in public/css/style.css — Astro strips scoped @keyframes */
</style>

<script is:inline>
document.addEventListener('DOMContentLoaded', function() {
  /* ====== STATE ====== */
  var THEME_KEY = 'beebanelabs_theme';
  var isNightMode = false;
  var threeLoaded = false;
  var threeInitializing = false;

  /* Restore saved theme */
  var saved = localStorage.getItem(THEME_KEY);
  if (saved === 'night') {
    isNightMode = true;
    document.body.classList.add('reading-sky-night');
  }

  var toggleBtn = document.getElementById('reading-sky-toggle');
  var clockEl = document.querySelector('#reading-sky-hud .clock');
  var phaseEl = document.querySelector('#reading-sky-hud .phase');

  function updateHud() {
    clockEl.textContent = isNightMode ? '🌙' : '☀️';
    phaseEl.textContent = isNightMode ? 'Malam' : 'Siang';
  }

  /* ====== THREE.JS LAZY LOADER ====== */
  function loadThreeJS(callback) {
    if (window.THREE) { callback(window.THREE); return; }
    if (threeInitializing) {
      // Another call is already loading — wait for it
      var check = setInterval(function() {
        if (window.THREE) { clearInterval(check); callback(window.THREE); }
      }, 50);
      return;
    }
    threeInitializing = true;
    var s = document.createElement('script');
    s.src = 'https://cdn.jsdelivr.net/npm/three@0.160.0/build/three.min.js';
    s.onload = function() { callback(window.THREE); };
    s.onerror = function() { console.error('Failed to load Three.js'); };
    document.head.appendChild(s);
  }

  /* ====== THREE.JS SCENE INIT ====== */
  function initThreeScene(THREE) {
    if (threeLoaded) return;
    threeLoaded = true;

    var PAL = {
      day: {
        skyTop: new THREE.Color('#bfe3fb'),
        skyHorizon: new THREE.Color('#fdf6e8'),
        ground: new THREE.Color('#1F3A3D'),
        groundFar: new THREE.Color('#2C4F4F')
      },
      night: {
        skyTop: new THREE.Color('#050714'),
        skyHorizon: new THREE.Color('#2B2B52'),
        ground: new THREE.Color('#05070A'),
        groundFar: new THREE.Color('#0a0c17')
      }
    };

    var canvas = document.getElementById('reading-sky-canvas');
    if (!canvas) return;

    var renderer = new THREE.WebGLRenderer({ canvas: canvas, antialias: true });
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    renderer.setSize(window.innerWidth, window.innerHeight);

    var scene = new THREE.Scene();
    var camera = new THREE.PerspectiveCamera(55, window.innerWidth / window.innerHeight, 0.1, 2000);
    camera.position.set(0, 12, 46);
    camera.lookAt(0, 14, -60);

    /* Sky dome */
    var skyGeo = new THREE.SphereGeometry(400, 32, 32);
    var skyMat = new THREE.ShaderMaterial({
      uniforms: { uTop: { value: new THREE.Color() }, uHorizon: { value: new THREE.Color() } },
      side: THREE.BackSide,
      depthWrite: false,
      vertexShader: 'varying vec3 vPos; void main(){ vPos = position; gl_Position = projectionMatrix * modelViewMatrix * vec4(position, 1.0); }',
      fragmentShader: 'uniform vec3 uTop; uniform vec3 uHorizon; varying vec3 vPos; void main(){ float h = clamp(normalize(vPos).y * 1.4 + 0.15, 0.0, 1.0); gl_FragColor = vec4(mix(uHorizon, uTop, h), 1.0); }'
    });
    scene.add(new THREE.Mesh(skyGeo, skyMat));

    /* Stars */
    var STAR_COUNT = 900;
    var starGeo = new THREE.BufferGeometry();
    var starPos = new Float32Array(STAR_COUNT * 3);
    for (var i = 0; i < STAR_COUNT; i++) {
      var r = 300 + Math.random() * 60;
      var theta = Math.random() * Math.PI * 2;
      var phi = Math.acos(Math.random() * 0.85);
      starPos[i*3] = r * Math.sin(phi) * Math.cos(theta);
      starPos[i*3+1] = Math.abs(r * Math.cos(phi)) + 20;
      starPos[i*3+2] = r * Math.sin(phi) * Math.sin(theta) - 100;
    }
    starGeo.setAttribute('position', new THREE.BufferAttribute(starPos, 3));
    var starMat = new THREE.PointsMaterial({ color: 0xffffff, size: 1.6, transparent: true, opacity: 0, depthWrite: false });
    scene.add(new THREE.Points(starGeo, starMat));

    /* Glow texture */
    function makeGlowTexture(hex) {
      var size = 128;
      var c = document.createElement('canvas');
      c.width = c.height = size;
      var ctx = c.getContext('2d');
      var g = ctx.createRadialGradient(size/2,size/2,0,size/2,size/2,size/2);
      g.addColorStop(0, hex + 'ff');
      g.addColorStop(0.35, hex + '88');
      g.addColorStop(1, hex + '00');
      ctx.fillStyle = g;
      ctx.fillRect(0,0,size,size);
      return new THREE.CanvasTexture(c);
    }

    /* Moon */
    var moon = new THREE.Mesh(new THREE.SphereGeometry(5, 24, 24), new THREE.MeshBasicMaterial({ color: 0xDCE3F0 }));
    var moonGlow = new THREE.Sprite(new THREE.SpriteMaterial({ map: makeGlowTexture('#8FA8D6'), transparent: true, depthWrite: false, blending: THREE.AdditiveBlending }));
    moonGlow.scale.set(34, 34, 1);
    moon.add(moonGlow);
    scene.add(moon);

    /* Mountains */
    function makeMountainRow(zPos, height, color) {
      var points = [];
      var segs = 10;
      for (var j = 0; j <= segs; j++) {
        var x = (j/segs - 0.5) * 500;
        var y = Math.sin(j*1.7 + zPos) * height * 0.4 + height * (0.4 + Math.random()*0.3);
        points.push(new THREE.Vector2(x, y));
      }
      points.unshift(new THREE.Vector2(-250, -20));
      points.push(new THREE.Vector2(250, -20));
      var shape = new THREE.Shape(points);
      var mesh = new THREE.Mesh(new THREE.ShapeGeometry(shape), new THREE.MeshBasicMaterial({ color: color }));
      mesh.position.z = zPos;
      mesh.position.y = -6;
      return mesh;
    }
    var groundFar = makeMountainRow(-90, 22, PAL.night.groundFar.getHex());
    var groundNear = makeMountainRow(-40, 14, PAL.night.ground.getHex());
    scene.add(groundFar, groundNear);

    /* Trees */
    var treeGroup = new THREE.Group();
    var treeGeo = new THREE.ConeGeometry(1.6, 5, 6);
    for (var ti = 0; ti < 22; ti++) {
      var t = new THREE.Mesh(treeGeo, new THREE.MeshBasicMaterial({ color: PAL.night.ground.getHex() }));
      t.position.set((Math.random()-0.5)*140, -3 + Math.random()*1.5, -30 - Math.random()*15);
      t.scale.setScalar(0.7 + Math.random()*0.9);
      treeGroup.add(t);
    }
    scene.add(treeGroup);

    /* Fireflies — glowing sprites instead of square points */
    var FIREFLY_COUNT = 30;
    var fireflies = [];
    var fireflyTexture = makeGlowTexture('#C9F26C');
    for (var fi = 0; fi < FIREFLY_COUNT; fi++) {
      var sprite = new THREE.Sprite(new THREE.SpriteMaterial({
        map: fireflyTexture,
        color: 0xC9F26C,
        transparent: true,
        opacity: 0,
        depthWrite: false,
        blending: THREE.AdditiveBlending
      }));
      sprite.scale.set(1.8, 1.8, 1);
      sprite.position.set(
        (Math.random()-0.5)*100,
        -2 + Math.random()*8,
        -35 + Math.random()*30
      );
      sprite.userData = {
        seed: Math.random()*Math.PI*2,
        baseX: sprite.position.x,
        baseY: sprite.position.y,
        speed: 0.4 + Math.random()*0.6,
        flickerSpeed: 2 + Math.random()*3
      };
      scene.add(sprite);
      fireflies.push(sprite);
    }
    var fireflyMat = { opacity: 0 }; // dummy for nightFactor control

    /* State */
    var timeOfDay = 0.75; // Start night (canvas hidden by CSS)
    var manualTarget = null;
    var mouseX = 0, mouseY = 0;
    var clock = new THREE.Clock();

    window.addEventListener('mousemove', function(e) {
      mouseX = (e.clientX / window.innerWidth - 0.5);
      mouseY = (e.clientY / window.innerHeight - 0.5);
    });

    /* Animate time when toggling */
    toggleBtn.addEventListener('click', function() {
      manualTarget = isNightMode ? 0.75 : 0.25;
    });

    window.addEventListener('resize', function() {
      camera.aspect = window.innerWidth / window.innerHeight;
      camera.updateProjectionMatrix();
      renderer.setSize(window.innerWidth, window.innerHeight);
    });

    function animate() {
      requestAnimationFrame(animate);
      var dt = clock.getDelta();
      var t = clock.getElapsedTime();

      if (manualTarget !== null) {
        timeOfDay += (manualTarget - timeOfDay) * Math.min(1, dt * 2.2);
        if (Math.abs(manualTarget - timeOfDay) < 0.002) {
          timeOfDay = manualTarget;
          manualTarget = null;
        }
      }

      var angle = timeOfDay * Math.PI * 2;
      var sunHeight = Math.sin(angle);
      var moonHeight = Math.sin(angle + Math.PI);
      var nightFactor = Math.max(0, moonHeight);

      /* Moon position */
      moon.position.set(Math.cos(angle + Math.PI) * -130, 20 + moonHeight * 70, -140);
      moon.visible = moonHeight > -0.08;

      /* Sky colors (always dark for night canvas) */
      skyMat.uniforms.uTop.value.copy(PAL.night.skyTop);
      skyMat.uniforms.uHorizon.value.copy(PAL.night.skyHorizon);

      /* Ground */
      groundNear.material.color.copy(PAL.night.ground);
      groundFar.material.color.copy(PAL.night.groundFar);
      treeGroup.children.forEach(function(tr) { tr.material.color.copy(PAL.night.ground); });

      /* Stars & fireflies */
      starMat.opacity = nightFactor * 0.9;
      for (var i = 0; i < fireflies.length; i++) {
        var f = fireflies[i];
        var ud = f.userData;
        // Drift movement
        f.position.x = ud.baseX + Math.sin(t * ud.speed + ud.seed) * 3;
        f.position.y = ud.baseY + Math.cos(t * ud.speed * 0.7 + ud.seed) * 1.5;
        // Flicker opacity — simulates firefly blinking
        var flicker = (Math.sin(t * ud.flickerSpeed + ud.seed) * 0.5 + 0.5);
        f.material.opacity = nightFactor * 0.85 * flicker;
        // Pulse size
        var pulse = 1.2 + flicker * 0.8;
        f.scale.set(pulse, pulse, 1);
      }

      /* Camera parallax */
      camera.position.x += (mouseX * 8 - camera.position.x) * 0.03;
      camera.position.y += (12 - mouseY * 4 - camera.position.y) * 0.03;
      camera.lookAt(0, 14, -60);

      renderer.render(scene, camera);
    }

    animate();
  }

  /* ====== TOGGLE HANDLER ====== */
  toggleBtn.addEventListener('click', function() {
    isNightMode = !isNightMode;
    document.body.classList.toggle('reading-sky-night', isNightMode);
    localStorage.setItem(THEME_KEY, isNightMode ? 'night' : 'day');
    var meta = document.querySelector('meta[name="theme-color"]');
    if (meta) meta.content = isNightMode ? '#08090a' : '#bfe3fb';
    updateHud();

    /* Lazy-load Three.js when switching to night mode */
    if (isNightMode && !threeLoaded) {
      loadThreeJS(initThreeScene);
    }
  });

  updateHud();

  /* ====== AUTO-LOAD THREE.JS IF NIGHT MODE ====== */
  if (isNightMode) {
    loadThreeJS(initThreeScene);
  }
});
</script>
