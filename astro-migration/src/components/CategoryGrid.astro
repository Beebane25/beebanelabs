---
import { CATEGORY_DEFS } from '../data/site';

interface Props {
  showHeader?: boolean;
  compact?: boolean;
}

const { showHeader = false, compact = false } = Astro.props;
---

<section class:list={['categories-section', { compact }]} id="categories">
  <div class="container">
    {showHeader && (
      <div class="section-header fade-in">
        <span class="tag">// Kategori</span>
        <h2>Pilih Topik yang Ingin Dipelajari</h2>
        <p>Materi tutorial tersusun dari dasar hingga lanjut</p>
      </div>
    )}

    <div class="category-grid fade-in">
      {CATEGORY_DEFS.map((category) => (
        <a
          href={`/kategori/${category.slug}.html`}
          class="category-card"
          data-cat={category.key}
          style={`--card-accent: ${category.color};`}
        >
          <div class="icon" aria-hidden="true">{category.icon}</div>
          <h3>{category.name}</h3>
          <p>{category.desc}</p>
          <div class="article-count" aria-live="polite">Lihat tutorial</div>
        </a>
      ))}
    </div>
  </div>
</section>

<style is:global>
  .category-card {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  .categories-section.compact {
    padding-block: 2rem;
  }
</style>
