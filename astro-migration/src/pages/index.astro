---
// src/pages/index.astro — Homepage BeebaneLabs (identik dari index.html)
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="BeebaneLabs - Portal Tutorial Teknologi & IT Indonesia"
  description="Tutorial lengkap teknologi & IT — Web Development, Database, AI & Data Science, Mobile, DevOps, Cloud, IoT, Cybersecurity, dan karir IT. Belajar dari nol hingga mahir."
  canonicalUrl="https://beebanelabs.pages.dev"
>


  <!-- ========== HERO ========== -->

  <section class="hero">

    <div class="hero-sun"></div>

    <div class="particles">

      <div class="particle"></div>

      <div class="particle"></div>

      <div class="particle"></div>

      <div class="particle"></div>

      <div class="particle"></div>

    </div>

    <div class="container hero-container">

      <div class="hero-content">

        <div class="hero-badge">

          <span class="pulse"></span>

          Tutorial Teknologi Terbaru Setiap Minggu

        </div>

        <h1>

          Belajar <span class="gradient-text">Teknologi & IT</span><br>

          dari Nol hingga Mahir

        </h1>

        <p class="hero-description">

          Panduan lengkap pemrograman, IoT, cybersecurity, networking, dan dasar IT.

          Cocok untuk pemula hingga engineer profesional.

        </p>

        <div class="hero-actions">

          <a href="#articles" class="btn-primary">

            🚀 Mulai Belajar

          </a>

          <a href="#categories" class="btn-secondary">

            📚 Lihat Kategori

          </a>

        </div>

        <div class="hero-stats">

          <div class="hero-stat">

            <div class="number"><span class="accent stat-number">451+</span></div>

            <div class="label">Tutorial Lengkap</div>

          </div>

          <div class="hero-stat">

            <div class="number"><span class="accent stat-number">18</span></div>

            <div class="label">Topik Utama</div>

          </div>

          <div class="hero-stat">

            <div class="number"><span class="accent stat-number">100%</span></div>

            <div class="label">Gratis & Original</div>

          </div>

        </div>

      </div>

      <div class="hero-visual">

        <div class="hero-illustration">

          <div class="code-window">

            <div class="code-header">

              <span class="dot red"></span>

              <span class="dot yellow"></span>

              <span class="dot green"></span>

              <span class="code-title">main.py</span>

            </div>

            <div class="code-body">

              <span class="code-line"><span class="kw">import</span> <span class="mod">machine</span></span>

              <span class="code-line"><span class="kw">from</span> <span class="mod">mqtt</span> <span class="kw">import</span> <span class="fn">Client</span></span>

              <span class="code-line"></span>

              <span class="code-line"><span class="cmt"># IoT Sensor Setup</span></span>

              <span class="code-line"><span class="var">led</span> = machine.<span class="fn">Pin</span>(<span class="num">2</span>, machine.<span class="var">Pin</span>.OUT)</span>

              <span class="code-line"><span class="var">sensor</span> = machine.<span class="fn">ADC</span>(<span class="num">0</span>)</span>

              <span class="code-line"></span>

              <span class="code-line"><span class="kw">def</span> <span class="fn">on_message</span>(<span class="var">msg</span>):</span>

              <span class="code-line">    <span class="var">led</span>.<span class="fn">value</span>(<span class="num">1</span>)</span>

              <span class="code-line">    <span class="var">data</span> = <span class="var">sensor</span>.<span class="fn">read</span>()</span>

              <span class="code-line">    <span class="var">client</span>.<span class="fn">publish</span>(</span>

              <span class="code-line">        <span class="str">"iot/sensor"</span>, <span class="var">data</span></span>

              <span class="code-line">    )</span>

            </div>

          </div>

          <div class="floating-icons">

            <div class="float-icon icon-1">🔧</div>

            <div class="float-icon icon-2">📡</div>

            <div class="float-icon icon-3">🔐</div>

            <div class="float-icon icon-4">💻</div>

          </div>

        </div>

      </div>

    </div>

  </section>



  <!-- ========== AD SLOT ========== -->

  <div class="container">

    <div class="ad-slot ad-slot-wide" id="ad-slot-top">
      <ins class="adsbygoogle"
           style="display:block"
           data-ad-client="ca-pub-2122797411859663"
           data-ad-format="auto"
           data-full-width-responsive="true"></ins>
      <script>(adsbygoogle = window.adsbygoogle || []).push({});</script>
    </div>

  </div>



  <!-- ========== CATEGORIES ========== -->

  <section class="categories-section" id="categories">

    <div class="container">

      <div class="section-header fade-in">

        <span class="tag">// Kategori</span>

        <h2>Pilih Topik yang Ingin Dipelajari</h2>

        <p>Materi tutorial tersusun dari dasar hingga lanjut</p>

      </div>


      <div class="category-grid fade-in">

        <a href="/kategori/iot.html" class="category-card" data-cat="iot" style="--card-accent: #00e5ff;">

          <div class="icon">🤖</div>

          <h3>Internet of Things</h3>

          <p>ESP32, Arduino, sensor, LoRa, mikrokontroler, dan embedded systems</p>

          <div class="article-count">20+ Tutorial</div>

        </a>

        <a href="/kategori/networking.html" class="category-card" data-cat="networking" style="--card-accent: #fb923c;">

          <div class="icon">🌐</div>

          <h3>Networking</h3>

          <p>MikroTik, routing, firewall, VPN, dan manajemen jaringan profesional</p>

          <div class="article-count">11+ Tutorial</div>

        </a>

        <a href="/kategori/python.html" class="category-card" data-cat="programming" style="--card-accent: #ffeb00;">

          <div class="icon">💻</div>

          <h3>Pemrograman</h3>

          <p>Python, Arduino C/C++, scripting, dan otomasi untuk berbagai kebutuhan</p>

          <div class="article-count">41+ Tutorial</div>

        </a>

        <a href="/kategori/keamanan.html" class="category-card" data-cat="security" style="--card-accent: #f43f5e;">

          <div class="icon">🔐</div>

          <h3>Cybersecurity</h3>

          <p>Keamanan jaringan, firewall, VPN, enkripsi, dan pertahanan siber</p>

          <div class="article-count">25+ Tutorial</div>

        </a>

        <a href="/kategori/dashboard.html" class="category-card" data-cat="dashboard" style="--card-accent: #eab308;">

          <div class="icon">📊</div>

          <h3>Dashboard & Cloud</h3>

          <p>Node-RED, Grafana, Firebase, dan monitoring real-time</p>

          <div class="article-count">11+ Tutorial</div>

        </a>

        <a href="/kategori/protokol.html" class="category-card" data-cat="protocol" style="--card-accent: #7c5cff;">

          <div class="icon">📡</div>

          <h3>Protokol & Tools</h3>

          <p>MQTT, CoAP, HTTP, Arduino IDE, dan tools pengembangan</p>

          <div class="article-count">10+ Tutorial</div>

        </a>

        <a href="/kategori/web-development.html" class="category-card" data-cat="webdev" style="--card-accent: #3b82f6;">

          <div class="icon">🌐</div>

          <h3>Web Development</h3>

          <p>HTML, CSS, JavaScript, React, Vue, dan framework web modern</p>

          <div class="article-count">45+ Tutorial</div>

        </a>

        <a href="/kategori/database.html" class="category-card" data-cat="database" style="--card-accent: #10b981;">

          <div class="icon">🗄️</div>

          <h3>Database</h3>

          <p>SQL, MongoDB, Redis, database design, dan manajemen data</p>

          <div class="article-count">20+ Tutorial</div>

        </a>

        <a href="/kategori/ai-data-science.html" class="category-card" data-cat="ai" style="--card-accent: #8b5cf6;">

          <div class="icon">🤖</div>

          <h3>AI & Data Science</h3>

          <p>Machine learning, data analysis, ChatGPT, dan Python untuk data</p>

          <div class="article-count">21+ Tutorial</div>

        </a>

        <a href="/kategori/mobile.html" class="category-card" data-cat="mobile" style="--card-accent: #ec4899;">

          <div class="icon">📱</div>

          <h3>Mobile Development</h3>

          <p>Flutter, React Native, Android, dan desain mobile</p>

          <div class="article-count">14+ Tutorial</div>

        </a>

        <a href="/kategori/devops-cloud.html" class="category-card" data-cat="devops" style="--card-accent: #f97316;">

          <div class="icon">⚙️</div>

          <h3>DevOps & Cloud</h3>

          <p>Docker, CI/CD, AWS, Kubernetes, dan cloud infrastructure</p>

          <div class="article-count">24+ Tutorial</div>

        </a>

        <a href="/kategori/it-career.html" class="category-card" data-cat="career" style="--card-accent: #06b6d4;">

          <div class="icon">💼</div>

          <h3>IT Career</h3>

          <p>Roadmap belajar, sertifikasi, portfolio, dan pengembangan karir</p>

          <div class="article-count">14+ Tutorial</div>

        </a>

      </div>

    </div>

  </section>



  <!-- ========== AD SLOT ========== -->

  <div class="container">

    <div class="ad-slot ad-slot-wide" id="ad-slot-mid">
      <ins class="adsbygoogle"
           style="display:block"
           data-ad-client="ca-pub-2122797411859663"
           data-ad-format="auto"
           data-full-width-responsive="true"></ins>
      <script>(adsbygoogle = window.adsbygoogle || []).push({});</script>
    </div>

  </div>



  <!-- ========== FEATURED ARTICLES ========== -->

  <section class="articles-section" id="articles">

    <div class="container">

      <div class="section-header fade-in">

        <span class="tag">// Artikel Terbaru</span>

        <h2>Tutorial Paling Populer</h2>

        <p>Materi paling banyak dibaca oleh komunitas kami</p>

      </div>


      <div class="articles-grid" id="articlesGrid">

        <!-- Populated by JS: 3 articles per category -->

      </div>

      <div style="text-align:center;margin-top:32px;">

        <a href="/kategori.html" class="btn-upgrade" style="text-decoration:none;">📚 Lihat Semua Artikel →</a>

      </div>

    </div>

  </section>



  <!-- ========== POPULAR TAGS ========== -->

  <section class="tags-section">

    <div class="container">

      <div class="section-header fade-in">

        <span class="tag">// Topik Populer</span>

        <h2>Jelajahi Berdasarkan Tag</h2>

      </div>

      <div class="tags-container fade-in">

        <span class="tag-pill">Python</span>

        <span class="tag-pill">JavaScript</span>

        <span class="tag-pill">ESP32</span>

        <span class="tag-pill">React</span>

        <span class="tag-pill">Docker</span>

        <span class="tag-pill">SQL</span>

        <span class="tag-pill">Machine Learning</span>

        <span class="tag-pill">Flutter</span>

        <span class="tag-pill">Linux</span>

        <span class="tag-pill">MikroTik</span>

        <span class="tag-pill">AWS</span>

        <span class="tag-pill">TypeScript</span>

        <span class="tag-pill">MongoDB</span>

        <span class="tag-pill">Cybersecurity</span>

        <span class="tag-pill">Git</span>

        <span class="tag-pill">MQTT</span>

        <span class="tag-pill">LoRa</span>

        <span class="tag-pill">Firewall</span>

        <span class="tag-pill">VPN</span>

        <span class="tag-pill">API</span>

        <span class="tag-pill">Database</span>

        <span class="tag-pill">Raspberry Pi</span>

        <span class="tag-pill">Node-RED</span>

        <span class="tag-pill">Grafana</span>

        <span class="tag-pill">Firebase</span>

        <span class="tag-pill">TCP/IP</span>

        <span class="tag-pill">HTTP</span>

      </div>

    </div>

  </section>



  <!-- ========== AD SLOT ========== -->

  <div class="container">

    <div class="ad-slot ad-slot-wide" id="ad-slot-bottom">
      <ins class="adsbygoogle"
           style="display:block"
           data-ad-client="ca-pub-2122797411859663"
           data-ad-format="auto"
           data-full-width-responsive="true"></ins>
      <script>(adsbygoogle = window.adsbygoogle || []).push({});</script>
    </div>

  </div>



  <!-- ========== NEWSLETTER ========== -->

  <section class="newsletter-section" id="newsletter">

    <div class="container">

      <div class="newsletter-card fade-in">

        <h2>📬 Dapatkan Tutorial Terbaru</h2>

        <p>Subscribe untuk mendapatkan tutorial IT terbaru langsung di inbox kamu. Gratis, tanpa spam.</p>

        <form class="newsletter-form" onsubmit="handleSubscribe(event)">

          <input type="email" placeholder="email@kamu.com" required>

          <button type="submit" class="btn-primary">Subscribe</button>

        </form>

      </div>

    </div>

  </section>


</Layout>
