---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Kategori - BeebaneLabs" description="Jelajahi semua kategori tutorial teknologi di BeebaneLabs." canonicalUrl="https://beebanelabs.pages.dev/kategori.html">

<div class="search-overlay" id="searchOverlay">
    <button class="search-close-btn" aria-label="Tutup pencarian">&times;</button>
    <div class="search-box">
      <div class="search-input-wrapper">
        <input type="text" id="searchInput" placeholder="Ketik untuk mencari tutorial..." aria-label="Cari tutorial" autocomplete="off">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
      </div>
      <div class="search-results" id="searchResults">
        <div class="search-hint">Ketik untuk mencari</div>
      </div>
    </div>
  </div>




  <section class="article-hero">

    <div class="container">

      <div class="breadcrumb"><a href="index.html">Beranda</a><span class="separator">›</span><span>Kategori</span></div>

      <h1>📚 Semua Kategori</h1>

      <div class="meta-row"><span class="meta-item">📖 451+ Tutorial</span><span class="meta-item">🏷️ 12 Kategori</span></div>

    </div>

  </section>



  <section style="padding:40px 0 80px;">

    <div class="container">

      <div class="category-grid" id="categoryGrid"></div>

    </div>

  </section>

</Layout>
