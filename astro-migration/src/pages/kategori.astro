---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Kategori - BeebaneLabs" description="Jelajahi semua kategori tutorial teknologi di BeebaneLabs." canonicalUrl="https://beebanelabs.pages.dev/kategori.html">

  <section class="article-hero">
    <div class="container">
      <div class="breadcrumb"><a href="index.html">Beranda</a><span class="separator">›</span><span>Kategori</span></div>
      <h1>📚 Semua Kategori</h1>
      <div class="meta-row"><span class="meta-item">📖 451+ Tutorial</span><span class="meta-item">🏷️ 12 Kategori</span></div>
    </div>
  </section>

  <section style="padding:40px 0 80px;">
    <div class="container">
      <div class="category-grid">

        <a href="/kategori/iot.html" class="category-card" style="--card-accent: #00e5ff;">
          <div class="icon">🤖</div>
          <h3>Internet of Things</h3>
          <p>ESP32, Arduino, sensor, LoRa, mikrokontroler, dan embedded systems</p>
          <div class="article-count">37+ Tutorial</div>
        </a>

        <a href="/kategori/networking.html" class="category-card" style="--card-accent: #fb923c;">
          <div class="icon">🌐</div>
          <h3>Networking</h3>
          <p>MikroTik, routing, firewall, VPN, dan manajemen jaringan profesional</p>
          <div class="article-count">24+ Tutorial</div>
        </a>

        <a href="/kategori/python.html" class="category-card" style="--card-accent: #ffeb00;">
          <div class="icon">💻</div>
          <h3>Pemrograman</h3>
          <p>Python, Arduino C/C++, scripting, dan otomasi untuk berbagai kebutuhan</p>
          <div class="article-count">92+ Tutorial</div>
        </a>

        <a href="/kategori/keamanan.html" class="category-card" style="--card-accent: #f43f5e;">
          <div class="icon">🔐</div>
          <h3>Cybersecurity</h3>
          <p>Keamanan jaringan, firewall, VPN, enkripsi, dan pertahanan siber</p>
          <div class="article-count">40+ Tutorial</div>
        </a>

        <a href="/kategori/dashboard.html" class="category-card" style="--card-accent: #eab308;">
          <div class="icon">📊</div>
          <h3>Dashboard & Cloud</h3>
          <p>Node-RED, Grafana, Firebase, dan monitoring real-time</p>
          <div class="article-count">20+ Tutorial</div>
        </a>

        <a href="/kategori/protokol.html" class="category-card" style="--card-accent: #7c5cff;">
          <div class="icon">📡</div>
          <h3>Protokol & Tools</h3>
          <p>MQTT, CoAP, HTTP, Arduino IDE, dan tools pengembangan</p>
          <div class="article-count">18+ Tutorial</div>
        </a>

        <a href="/kategori/web-development.html" class="category-card" style="--card-accent: #3b82f6;">
          <div class="icon">🌐</div>
          <h3>Web Development</h3>
          <p>HTML, CSS, JavaScript, React, Vue, dan framework web modern</p>
          <div class="article-count">62+ Tutorial</div>
        </a>

        <a href="/kategori/database.html" class="category-card" style="--card-accent: #10b981;">
          <div class="icon">🗄️</div>
          <h3>Database</h3>
          <p>SQL, MongoDB, Redis, database design, dan manajemen data</p>
          <div class="article-count">35+ Tutorial</div>
        </a>

        <a href="/kategori/ai-data-science.html" class="category-card" style="--card-accent: #8b5cf6;">
          <div class="icon">🤖</div>
          <h3>AI & Data Science</h3>
          <p>Machine learning, data analysis, ChatGPT, dan Python untuk data</p>
          <div class="article-count">37+ Tutorial</div>
        </a>

        <a href="/kategori/mobile.html" class="category-card" style="--card-accent: #ec4899;">
          <div class="icon">📱</div>
          <h3>Mobile Development</h3>
          <p>Flutter, React Native, Android, dan desain mobile</p>
          <div class="article-count">28+ Tutorial</div>
        </a>

        <a href="/kategori/devops-cloud.html" class="category-card" style="--card-accent: #f97316;">
          <div class="icon">⚙️</div>
          <h3>DevOps & Cloud</h3>
          <p>Docker, CI/CD, AWS, Kubernetes, dan cloud infrastructure</p>
          <div class="article-count">40+ Tutorial</div>
        </a>

        <a href="/kategori/it-career.html" class="category-card" style="--card-accent: #06b6d4;">
          <div class="icon">💼</div>
          <h3>IT Career</h3>
          <p>Roadmap belajar, sertifikasi, portfolio, dan pengembangan karir</p>
          <div class="article-count">30+ Tutorial</div>
        </a>

      </div>
    </div>
  </section>

</Layout>
