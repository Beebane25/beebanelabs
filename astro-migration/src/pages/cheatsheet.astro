---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Cheatsheet - Referensi Cepat Teknologi & IT | BeebaneLabs"
  description="Kumpulan cheatsheet dan referensi cepat untuk 12 topik teknologi: ESP32, Python, Git, Docker, SQL, dan lainnya."
  canonicalUrl="https://beebanelabs.pages.dev/cheatsheet.html"
>

<div class="search-overlay" id="searchOverlay">
    <button class="search-close-btn" aria-label="Tutup pencarian">&times;</button>
    <div class="search-box">
      <div class="search-input-wrapper">
        <input type="text" id="searchInput" placeholder="Ketik untuk mencari tutorial..." aria-label="Cari tutorial" autocomplete="off">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
      </div>
      <div class="search-results" id="searchResults"><div class="search-hint">Ketik untuk mencari</div></div>
    </div>
  </div>

  <main id="main-content">
    <section class="hero-section" style="padding:60px 0 40px;text-align:center;">
      <div class="container">
        <div style="font-size:3rem;margin-bottom:12px;">📋</div>
        <h1 style="margin-bottom:12px;">Cheatsheet & Referensi Cepat</h1>
        <p style="color:var(--text-secondary);max-width:600px;margin:0 auto;">Kumpulan cheatsheet ringkas untuk 12 topik teknologi. Gratis, siap pakai, bisa di-bookmark.</p>
      </div>
    </section>

    <section style="padding:0 0 60px;">
      <div class="container">
        <div class="category-grid" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:20px;">

          <a href="articles/cheatsheet-esp32-iot.html" class="category-card" style="border-radius:16px;padding:24px;background:var(--bg-card);border:1px solid var(--border-standard);text-decoration:none;transition:all 0.2s;">
            <div style="font-size:2rem;margin-bottom:8px;">🤖</div>
            <h3 style="color:var(--text-primary);margin-bottom:6px;font-size:1rem;">ESP32 & IoT</h3>
            <p style="color:var(--text-muted);font-size:0.85rem;margin:0;">Pinout, command Arduino, wiring sensor, MQTT</p>
          </a>

          <a href="articles/cheatsheet-python.html" class="category-card" style="border-radius:16px;padding:24px;background:var(--bg-card);border:1px solid var(--border-standard);text-decoration:none;transition:all 0.2s;">
            <div style="font-size:2rem;margin-bottom:8px;">💻</div>
            <h3 style="color:var(--text-primary);margin-bottom:6px;font-size:1rem;">Python</h3>
            <p style="color:var(--text-muted);font-size:0.85rem;margin:0;">Syntax, data structure, list comprehension, modules</p>
          </a>

          <a href="articles/cheatsheet-linux-security.html" class="category-card" style="border-radius:16px;padding:24px;background:var(--bg-card);border:1px solid var(--border-standard);text-decoration:none;transition:all 0.2s;">
            <div style="font-size:2rem;margin-bottom:8px;">🔐</div>
            <h3 style="color:var(--text-primary);margin-bottom:6px;font-size:1rem;">Linux Security</h3>
            <p style="color:var(--text-muted);font-size:0.85rem;margin:0;">iptables, SSH hardening, fail2ban, nmap</p>
          </a>

          <a href="articles/cheatsheet-grafana-nodered.html" class="category-card" style="border-radius:16px;padding:24px;background:var(--bg-card);border:1px solid var(--border-standard);text-decoration:none;transition:all 0.2s;">
            <div style="font-size:2rem;margin-bottom:8px;">📊</div>
            <h3 style="color:var(--text-primary);margin-bottom:6px;font-size:1rem;">Grafana & Node-RED</h3>
            <p style="color:var(--text-muted);font-size:0.85rem;margin:0;">PromQL, dashboard, flow automation, alerting</p>
          </a>

          <a href="articles/cheatsheet-mqtt-http.html" class="category-card" style="border-radius:16px;padding:24px;background:var(--bg-card);border:1px solid var(--border-standard);text-decoration:none;transition:all 0.2s;">
            <div style="font-size:2rem;margin-bottom:8px;">📡</div>
            <h3 style="color:var(--text-primary);margin-bottom:6px;font-size:1rem;">MQTT & HTTP</h3>
            <p style="color:var(--text-muted);font-size:0.85rem;margin:0;">QoS, topics, status codes, REST API, WebSocket</p>
          </a>

          <a href="articles/cheatsheet-html-css-js.html" class="category-card" style="border-radius:16px;padding:24px;background:var(--bg-card);border:1px solid var(--border-standard);text-decoration:none;transition:all 0.2s;">
            <div style="font-size:2rem;margin-bottom:8px;">🌐</div>
            <h3 style="color:var(--text-primary);margin-bottom:6px;font-size:1rem;">HTML, CSS & JavaScript</h3>
            <p style="color:var(--text-muted);font-size:0.85rem;margin:0;">Semantic HTML, Flexbox/Grid, ES6+, fetch API</p>
          </a>

          <a href="articles/cheatsheet-sql.html" class="category-card" style="border-radius:16px;padding:24px;background:var(--bg-card);border:1px solid var(--border-standard);text-decoration:none;transition:all 0.2s;">
            <div style="font-size:2rem;margin-bottom:8px;">🗄️</div>
            <h3 style="color:var(--text-primary);margin-bottom:6px;font-size:1rem;">SQL</h3>
            <p style="color:var(--text-muted);font-size:0.85rem;margin:0;">JOIN, GROUP BY, window functions, CTE, index</p>
          </a>

          <a href="articles/cheatsheet-python-datascience.html" class="category-card" style="border-radius:16px;padding:24px;background:var(--bg-card);border:1px solid var(--border-standard);text-decoration:none;transition:all 0.2s;">
            <div style="font-size:2rem;margin-bottom:8px;">🤖</div>
            <h3 style="color:var(--text-primary);margin-bottom:6px;font-size:1rem;">Python Data Science</h3>
            <p style="color:var(--text-muted);font-size:0.85rem;margin:0;">NumPy, Pandas, Matplotlib, Scikit-learn</p>
          </a>

          <a href="articles/cheatsheet-flutter-dart.html" class="category-card" style="border-radius:16px;padding:24px;background:var(--bg-card);border:1px solid var(--border-standard);text-decoration:none;transition:all 0.2s;">
            <div style="font-size:2rem;margin-bottom:8px;">📱</div>
            <h3 style="color:var(--text-primary);margin-bottom:6px;font-size:1rem;">Flutter & Dart</h3>
            <p style="color:var(--text-muted);font-size:0.85rem;margin:0;">Widget, state management, navigation, HTTP</p>
          </a>

          <a href="articles/cheatsheet-docker-k8s.html" class="category-card" style="border-radius:16px;padding:24px;background:var(--bg-card);border:1px solid var(--border-standard);text-decoration:none;transition:all 0.2s;">
            <div style="font-size:2rem;margin-bottom:8px;">⚙️</div>
            <h3 style="color:var(--text-primary);margin-bottom:6px;font-size:1rem;">Docker & Kubernetes</h3>
            <p style="color:var(--text-muted);font-size:0.85rem;margin:0;">Dockerfile, compose, kubectl, YAML manifests</p>
          </a>

          <a href="articles/cheatsheet-it-certification.html" class="category-card" style="border-radius:16px;padding:24px;background:var(--bg-card);border:1px solid var(--border-standard);text-decoration:none;transition:all 0.2s;">
            <div style="font-size:2rem;margin-bottom:8px;">💼</div>
            <h3 style="color:var(--text-primary);margin-bottom:6px;font-size:1rem;">IT Certification</h3>
            <p style="color:var(--text-muted);font-size:0.85rem;margin:0;">Roadmap, salary, exam tips, study guide</p>
          </a>

          <a href="articles/cheatsheet-networking-mikrotik.html" class="category-card" style="border-radius:16px;padding:24px;background:var(--bg-card);border:1px solid var(--border-standard);text-decoration:none;transition:all 0.2s;">
            <div style="font-size:2rem;margin-bottom:8px;">🌐</div>
            <h3 style="color:var(--text-primary);margin-bottom:6px;font-size:1rem;">Networking & MikroTik</h3>
            <p style="color:var(--text-muted);font-size:0.85rem;margin:0;">OSI, subnetting, RouterOS, firewall, VLAN</p>
          </a>

        </div>
      </div>
    </section>
  </main>

</Layout>
