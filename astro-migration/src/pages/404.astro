---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Halaman Tidak Ditemukan - BeebaneLabs"
  description="Halaman tidak ditemukan. Kembali ke beranda BeebaneLabs untuk tutorial teknologi."
  canonicalUrl="https://beebanelabs.pages.dev/404.html"
>

<section class="error-page">
    <div>
      <div class="error-code">404</div>
      <h1>Halaman Tidak Ditemukan</h1>
      <p>Halaman yang Anda cari tidak ada atau sudah dipindahkan. Coba cari tutorial yang Anda butuhkan:</p>
      <div style="margin-bottom:24px;">
        <input type="text" id="errorSearchInput" aria-label="Cari tutorial" placeholder="Cari tutorial..." style="width:100%;max-width:400px;padding:12px 16px;border-radius:10px;border:1px solid var(--border-standard);background:var(--bg-elevated);color:var(--text-primary);font-size:0.95rem;" onkeyup="if(event.key==='Enter'){window.location.href='/'}">
      </div>
      <div class="error-actions">
        <a href="/" class="btn-upgrade" style="text-decoration:none;">← Kembali ke Beranda</a>
        <a href="/kategori.html" class="btn-back" style="text-decoration:none;">📚 Lihat Kategori</a>
        <button class="btn-back" onclick="history.back()">← Kembali</button>
      </div>
      <div style="margin-top:32px;text-align:left;max-width:500px;">
        <h3 style="font-size:0.95rem;color:var(--text-secondary);margin-bottom:12px;">Tutorial Populer:</h3>
        <div style="display:flex;flex-direction:column;gap:8px;">
          <a href="/articles/python-pemula.html" style="color:var(--accent-primary);text-decoration:none;font-size:0.85rem;">🐍 Python untuk Pemula</a>
          <a href="/articles/esp32-fundamentals.html" style="color:var(--accent-primary);text-decoration:none;font-size:0.85rem;">🔧 Panduan Lengkap ESP32</a>
          <a href="/articles/docker-dasar.html" style="color:var(--accent-primary);text-decoration:none;font-size:0.85rem;">🐳 Docker untuk Pemula</a>
          <a href="/articles/javascript-pemula.html" style="color:var(--accent-primary);text-decoration:none;font-size:0.85rem;">⚡ JavaScript Dasar</a>
          <a href="/articles/react-dasar.html" style="color:var(--accent-primary);text-decoration:none;font-size:0.85rem;">⚛️ React untuk Pemula</a>
        </div>
      </div>
    </div>
  </section>

  <script defer src="js/security.js"></script>
  <script defer src="js/app.js?v=19.2"></script>
  <script defer src="js/mobile-zoom.js?v=9.2"></script>
<button class="theme-toggle-floating" title="Ganti tema" aria-label="Ganti tema">☀️</button>
<!-- MOBILE QUICK MENU -->
  <div id="quickMenuBackdrop" class="quick-menu-backdrop"></div>
  <button id="quickMenuBtn" class="quick-menu-btn" title="Menu" aria-label="Menu cepat">⚙️</button>
  <div id="quickMenuPanel" class="quick-menu-panel">
    <div class="quick-menu-section">
      <span class="quick-menu-label">🔍 Zoom</span>
      <div class="quick-menu-row">
        <button aria-label="Perkecil">−</button>
        <span id="quickMenuZoomLevel" class="zoom-level">100%</span>
        <button aria-label="Perbesar">+</button>
        <button class="btn-zoom-reset" aria-label="Reset zoom">↺</button>
      </div>
    </div>
    <div class="quick-menu-section">
      <span class="quick-menu-label">🎨 Tema</span>
      <button class="quick-menu-row quick-menu-theme-btn" aria-label="Ganti tema">
        <span id="quickMenuThemeIcon">☀️</span> <span>Ganti Tema</span>
      </button>
    </div>
  </div>

</Layout>
