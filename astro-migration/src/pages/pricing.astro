---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Harga - Paket Akses BeebaneLabs"
  description="Paket akses BeebaneLabs — Token untuk membuka tutorial premium. Mulai dari Rp10.000."
  canonicalUrl="https://beebanelabs.pages.dev/pricing.html"
>




  <!-- ========== PRICING HERO ========== -->
  <section class="article-hero">
    <div class="container">
      <div class="breadcrumb">
        <a href="index.html">Beranda</a>
        <span class="separator">›</span>
        <span>Harga & Langganan</span>
      </div>
      <h1>💎 Harga & Langganan</h1>
      <div class="meta-row">
        <span class="meta-item">⚡ Pilih Paket yang Tepat untuk Kamu</span>
        <span class="meta-item">🔒 Pembayaran Aman & Privasi Terjaga</span>
      </div>
    </div>
  </section>

  <!-- ========== PRICING CARDS ========== -->
  <section class="pricing-section" id="pricing-content">
    <div class="container">
      <div class="section-header">
        <span class="tag">💎 HARGA</span>
        <h2>Pilih Paket yang Tepat untuk Kamu</h2>
        <p style="color:var(--text-secondary); max-width:560px; margin:var(--space-md) auto 0;">Mulai dari gratis, upgrade kapan saja sesuai kebutuhan belajar kamu.</p>
      </div>

      <div class="pricing-grid">

        <!-- TOKEN GRATIS -->
        <div class="pricing-card" style="position:relative;">
          <div class="plan-icon">🔑</div>
          <div class="plan-name">TOKEN GRATIS</div>
          <div class="plan-price">5 <span class="period">token</span></div>
          <p style="color:var(--text-muted); font-size:0.85rem; margin-bottom:var(--space-lg);">Diberikan saat pertama kali daftar</p>
          <ul class="plan-features">
            <li>🔓 Buka 5 artikel pertama</li>
            <li>📖 1 token = 1 artikel</li>
            <li>⚡ Akses permanen setelah diunlock</li>
          </ul>
          <button class="plan-btn secondary" onclick="startPayment('free')">Mulai Gratis</button>
        </div>

        <!-- CUSTOM TOKEN (1-50) -->
        <div class="pricing-card featured" style="position:relative;">
          <div class="plan-icon">🎯</div>
          <div class="plan-name">CUSTOM TOKEN</div>
          <div class="plan-price" id="customPrice">Rp 10.000</div>
          <p style="color:var(--text-muted); font-size:0.85rem; margin-bottom:var(--space-md);">Pilih jumlah sesuai kebutuhan</p>
          <div style="margin-bottom:var(--space-lg);">
            <div style="display:flex;align-items:center;justify-content:center;gap:12px;margin-bottom:12px;">
              <button onclick="adjustCustomToken(-1)" class="token-adjust-btn">−</button>
              <input type="number" id="customTokenInput" value="10" min="1" max="50" oninput="updateCustomPrice()" aria-label="Jumlah token" style="width:70px;text-align:center;padding:8px;border-radius:var(--radius-md);border:2px solid var(--accent-primary);background:var(--bg-elevated);color:var(--text-primary);font-size:1.3rem;font-weight:700;font-family:var(--font-heading);">
              <button onclick="adjustCustomToken(1)" class="token-adjust-btn">+</button>
            </div>
            <input type="range" id="customTokenSlider" min="1" max="50" value="10" oninput="syncSliderToInput()" aria-label="Slider jumlah token" style="width:100%;accent-color:var(--accent-primary);margin-bottom:8px;">
            <div style="display:flex;justify-content:space-between;font-size:0.7rem;color:var(--text-subtle);">
              <span>1</span><span>10</span><span>25</span><span>50</span>
            </div>
            <div id="customDiscount" style="margin-top:8px;font-size:0.8rem;color:var(--accent-primary);font-weight:600;text-align:center;"></div>
          </div>
          <ul class="plan-features">
            <li>🔓 Buka artikel sesuai jumlah token</li>
            <li>📖 1 token = 1 artikel</li>
            <li>⚡ Akses permanen setelah diunlock</li>
            <li>💰 Diskon otomatis untuk pembelian banyak</li>
          </ul>
          <button class="plan-btn primary" onclick="startPayment('custom')">Beli Token</button>
        </div>

        <!-- PAKET 5 TOKEN -->
        <div class="pricing-card" style="position:relative;">
          <div class="plan-icon">💰</div>
          <div class="plan-name">PAKET 5 TOKEN</div>
          <div class="plan-price">Rp 50.000</div>
          <p style="color:var(--text-muted); font-size:0.85rem; margin-bottom:var(--space-lg);">Rp 10.000 per token</p>
          <ul class="plan-features">
            <li>🔓 Buka 5 artikel tambahan</li>
            <li>📖 1 token = 1 artikel</li>
            <li>⚡ Akses permanen setelah diunlock</li>
          </ul>
          <button class="plan-btn secondary" onclick="startPayment('token5')">Beli 5 Token</button>
        </div>

        <!-- PAKET 10 TOKEN -->
        <div class="pricing-card" style="position:relative;">
          <div class="plan-icon">📦</div>
          <div class="plan-name">PAKET 10 TOKEN</div>
          <div class="plan-price">Rp 90.000</div>
          <p style="color:var(--text-muted); font-size:0.85rem; margin-bottom:var(--space-lg);">Hemat Rp 10.000!</p>
          <ul class="plan-features">
            <li>🔓 Buka 10 artikel tambahan</li>
            <li>📖 1 token = 1 artikel</li>
            <li>⚡ Akses permanen setelah diunlock</li>
            <li>💰 Harga lebih hemat</li>
          </ul>
          <button class="plan-btn secondary" onclick="startPayment('token10')">Beli 10 Token</button>
        </div>

      </div>
    </div>
  </section>

  <!-- ========== FAQ SECTION ========== -->
  <section class="pricing-section" style="padding-top:0;">
    <div class="container" style="max-width:720px;">
      <div class="section-header">
        <span class="tag">❓ FAQ</span>
        <h2>Pertanyaan Umum</h2>
      </div>

      <div style="margin-top:var(--space-xl);">

        <div style="background:var(--bg-card); border:1px solid var(--border-card); border-radius:var(--radius-lg); padding:var(--space-lg); margin-bottom:var(--space-md);">
          <h3 style="font-size:1rem; margin-bottom:var(--space-sm); color:var(--text-primary);">Apakah ada masa percobaan gratis?</h3>
          <p style="color:var(--text-secondary); font-size:0.9rem; margin:0;">Ya! Paket Gratis memberikan akses ke 5 artikel pertama tanpa batas waktu. Kamu bisa merasakan kualitas konten kami sebelum memutuskan untuk upgrade ke paket berbayar.</p>
        </div>

        <div style="background:var(--bg-card); border:1px solid var(--border-card); border-radius:var(--radius-lg); padding:var(--space-lg); margin-bottom:var(--space-md);">
          <h3 style="font-size:1rem; margin-bottom:var(--space-sm); color:var(--text-primary);">Metode pembayaran apa yang diterima?</h3>
          <p style="color:var(--text-secondary); font-size:0.9rem; margin:0;">Kami menerima pembayaran melalui transfer bank (BCA, Mandiri, BRI), e-wallet (GoPay, OVO, Dana, ShopeePay), serta kartu kredit/debit. Semua transaksi diproses secara aman dan terenkripsi.</p>
        </div>

        <div style="background:var(--bg-card); border:1px solid var(--border-card); border-radius:var(--radius-lg); padding:var(--space-lg); margin-bottom:var(--space-md);">
          <h3 style="font-size:1rem; margin-bottom:var(--space-sm); color:var(--text-primary);">Apakah token bisa habis?</h3>
          <p style="color:var(--text-secondary); font-size:0.9rem; margin:0;">Ya, 1 token digunakan untuk membuka 1 artikel. Setelah diunlock, akses ke artikel tersebut bersifat permanen. Jika token habis, kamu bisa membeli token tambahan kapan saja.</p>
        </div>

        <div style="background:var(--bg-card); border:1px solid var(--border-card); border-radius:var(--radius-lg); padding:var(--space-lg); margin-bottom:var(--space-md);">
          <h3 style="font-size:1rem; margin-bottom:var(--space-sm); color:var(--text-primary);">Apakah artikel yang sudah diunlock bisa dibuka lagi?</h3>
          <p style="color:var(--text-secondary); font-size:0.9rem; margin:0;">Ya! Artikel yang sudah kamu unlock dengan token bisa diakses selamanya, tanpa perlu token lagi. Cek daftar artikel yang sudah dibuka di halaman profil.</p>
        </div>

      </div>
    </div>
  </section>

  <!-- ========== CTA SECTION ========== -->
  <section style="padding:var(--space-3xl) 0; text-align:center;">
    <div class="container" style="max-width:560px;">
      <h2 style="margin-bottom:var(--space-md);">Masih Ragu?</h2>
      <p style="color:var(--text-secondary); margin-bottom:var(--space-xl);">Mulai dari gratis sekarang. Upgrade kapan saja tanpa komitmen.</p>
      <a href="index.html" class="btn-primary">📚 Lihat Artikel Gratis</a>
    </div>
  </section>

  <!-- ========== FOOTER ========== -->

</Layout>
